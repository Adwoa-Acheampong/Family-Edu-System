# =============================================================================
# Family Edu Engine Room (FastAPI)
# Copy to .env and fill in. Never commit .env
#   copy .env.example .env
# =============================================================================

# --- Google OAuth (same Web client ID/secret as root .env) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must also be registered in Google Console Authorized redirect URIs
GOOGLE_REDIRECT_URI=http://localhost:3000/

# --- AI (OpenRouter preferred for chat; Gemini for chat fallback + OCR) ---
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# https://aistudio.google.com/apikey  (required for /v1/process-document OCR)
GEMINI_API_KEY=
# Optional override for OCR model (default: gemini-2.0-flash)
# GEMINI_OCR_MODEL=gemini-2.5-flash

# --- Token encryption (REQUIRED to store OAuth tokens) ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
TOKEN_ENCRYPTION_KEY=

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./engine_room.db

# --- CORS (frontend origins) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

LOG_LEVEL=INFO

# --- Optional: Gemini Notebook Enterprise ---
NOTEBOOKLM_PROJECT_NUMBER=
NOTEBOOKLM_LOCATION=global
NOTEBOOKLM_ENDPOINT_LOCATION=global
