# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/

# OpenRouter (primary AI gateway)
OPENROUTER_API_KEY=

# Gemini API key (fallback for younger personas)
GEMINI_API_KEY=

# Gemini Notebook Enterprise (Preview)
# Requires a licensed project and the Cloud Gemini Notebook User IAM role.
NOTEBOOKLM_PROJECT_NUMBER=
NOTEBOOKLM_LOCATION=global
NOTEBOOKLM_ENDPOINT_LOCATION=global

# Baidu OCR
BAIDU_API_KEY=
BAIDU_SECRET_KEY=

# Token encryption — 64 hex chars (32 bytes). Fernet key is derived from this.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
TOKEN_ENCRYPTION_KEY=

# Database
DATABASE_URL=sqlite+aiosqlite:///./engine_room.db

# CORS — include the Vite/Node frontend origin
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

LOG_LEVEL=INFO
