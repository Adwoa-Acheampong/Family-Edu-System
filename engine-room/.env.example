# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/v1/auth/callback

# OpenRouter (primary AI gateway)
OPENROUTER_API_KEY=

# Gemini API key (fallback for younger personas)
GEMINI_API_KEY=

# Baidu OCR
BAIDU_API_KEY=
BAIDU_SECRET_KEY=

# Token encryption (32-byte hex key, generate with: python -c "import secrets; print(secrets.token_hex(32))")
TOKEN_ENCRYPTION_KEY=

# Database
DATABASE_URL=sqlite+aiosqlite:///./engine_room.db

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO