# Node server / Gemini (server-side only — never VITE_ prefix for secrets)
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
APP_URL=http://localhost:3000
PORT=3000

# Frontend (Vite) — safe to expose
VITE_APP_NAME=Family Edu Hub
VITE_API_BASE_URL=
VITE_ENGINE_ROOM_URL=http://localhost:8000
VITE_POLL_INTERVAL_MS=15000
VITE_HEALTH_POLL_MS=10000
VITE_ENABLE_ANALYTICS=true
