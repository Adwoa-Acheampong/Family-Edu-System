# =============================================================================
# Family Edu Hub — Node bridge + Vite (ROOT)
# Copy to .env and fill in. Never commit .env
#   copy .env.example .env
# =============================================================================

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# --- Google OAuth (Web client from Google Cloud Console) ---
# Redirect URI must be listed in the OAuth client exactly:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# --- Gemini (Node /api/ai-chat, suggest-goals, generate-curriculum) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Frontend (Vite) — exposed to the browser; no secrets here ---
VITE_APP_NAME=Family Edu Hub
# Leave empty to use same origin as this server (recommended)
VITE_API_BASE_URL=
VITE_ENGINE_ROOM_URL=http://localhost:8000
VITE_POLL_INTERVAL_MS=15000
VITE_HEALTH_POLL_MS=10000
VITE_ENABLE_ANALYTICS=true
