# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (OAuth redirect base).
APP_URL="http://localhost:3000"

# Optional: point frontend at Python Engine Room later
# VITE_ENGINE_ROOM_URL="http://localhost:8000"

# Google OAuth (optional until you enable Sign in with Google)
# Create credentials in Google Cloud Console → OAuth 2.0 Client (Web)
# Authorized redirect URI must match GOOGLE_REDIRECT_URI
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

PORT=3000
