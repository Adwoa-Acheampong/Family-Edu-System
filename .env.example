# =============================================================================
# Family Edu Hub — Node bridge + Vite (ROOT)
# Copy to .env and fill in. Never commit .env
#   copy .env.example .env
# =============================================================================

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# --- Google OAuth (Web client from Google Cloud Console) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# --- Gemini (Node chat / goals / curriculum) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Frontend (Vite) — restart npm run dev after changes ---
VITE_APP_NAME=Family Edu Hub
# Leave empty = same-origin Node API for /api/*
VITE_API_BASE_URL=
# REQUIRED for YouTube transcript + notebook lesson ingest (/v1/lessons/*)
# Engine Room: uvicorn main:app --reload --port 8000
VITE_ENGINE_ROOM_URL=http://localhost:8000
VITE_POLL_INTERVAL_MS=15000
VITE_HEALTH_POLL_MS=10000
VITE_ENABLE_ANALYTICS=true
